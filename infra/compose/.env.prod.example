# W10-D2: production env template — copy to a file OUTSIDE the git checkout
# (e.g. D:\rxycode-prod\.env) and fill in real values. Never commit it; the
# deploy consumes it only via `docker compose --env-file`.
#
#   docker compose -p rxyprod --env-file D:\rxycode-prod\.env \
#     -f infra/compose/compose.yaml -f infra/compose/compose.prod.yaml up -d
#
# Variables marked REQUIRED make `compose config` fail while unset. Values
# below are placeholders showing format only.

# --- REQUIRED secrets ---------------------------------------------------------
# Postgres password; also embedded in the containers' RXYCODE_WEB_DATABASE_URL.
RXYCODE_POSTGRES_PASSWORD=            # REQUIRED e.g. output of `openssl rand -hex 24`
# Session/CSRF signing secret; >=32 chars, >=10 distinct chars.
RXYCODE_WEB_SECRET=                   # REQUIRED e.g. `openssl rand -hex 32`
# MinIO root credentials (artifact store behind the API).
RXYCODE_MINIO_ROOT_USER=              # REQUIRED
RXYCODE_MINIO_ROOT_PASSWORD=          # REQUIRED
# Platform LLM endpoint for the worker (openai-compatible) + its credential.
# Under BYOK (below) ordinary users run on their own keys; these feed ONLY
# runs submitted by RXYCODE_PLATFORM_MODEL_USERS. Optional — a worker with
# no platform endpoint still executes BYOK runs.
RXYCODE_LLM_BASE_URL=                 # e.g. https://api.deepseek.com/v1
RXYCODE_API_KEY=                      # key for the endpoint above
# BYOK keyring: master keys for AES-256-GCM sealing of user model keys.
# Generate once on the host (NOT in the repo):
#   python -m rxycode_server.byok.keyring generate /opt/rxycode/secrets/byok-keyring.json
# then keep it chmod 0600 root:root — api + worker containers (uid 0) read
# it via the read-only mount at /run/secrets/byok-keyring.json.
# Host path of the keyring, bind-mounted read-only into api + worker.
# Default: /opt/rxycode/secrets/byok-keyring.json
#RXYCODE_BYOK_KEYRING_HOST=/opt/rxycode/secrets/byok-keyring.json
# Comma-separated user ids allowed to use the platform key. Empty = nobody.
#RXYCODE_PLATFORM_MODEL_USERS=
# Dev/test only — permits http:// + private BYOK base URLs. Never set in prod.
#RXYCODE_BYOK_ALLOW_PRIVATE=
# CSRF Origin allowlist — REQUIRED, no insecure default in prod. The single
# public origin Tailscale Funnel serves (comma-separated if several):
RXYCODE_WEB_ORIGINS=                  # REQUIRED e.g. https://<machine>.<tailnet>.ts.net

# --- image / ports ------------------------------------------------------------
# Image tag built by infra/scripts/build-images.ps1 (git short sha or latest).
RXYCODE_IMAGE_TAG=latest
# Host-loopback port the gateway publishes; `tailscale funnel` points here.
RXYCODE_HTTP_PORT=8080

# --- admission / rate limit ---------------------------------------------------
# Registration mode: invite | open | closed (invite = one-shot codes minted
# via `python -m rxycode_server.admin invite create`).
RXYCODE_WEB_REGISTRATION=invite
# Requests/min per client IP at the app layer (0 disables).
RXYCODE_WEB_RATE_LIMIT_RPM=120
# Per-user concurrent active runs / daily task count / daily token ceiling
# (rolling 24h, real usage_records metering).
RXYCODE_QUOTA_CONCURRENCY=1
RXYCODE_QUOTA_TASKS_PER_DAY=30
RXYCODE_QUOTA_TOKENS_PER_DAY=2000000
# Global pending-run cap. KILL SWITCH: set to 0 and `up -d` — every new
# submission returns 429 QUOTA_EXCEEDED while running runs finish.
RXYCODE_QUEUE_MAX=10

# --- worker tuning ------------------------------------------------------------
# Worker identity / drain loop tuning (defaults shown; usually leave alone).
#RXYCODE_WORKER_ID=
#RXYCODE_WORKER_POLL_SECONDS=2
#RXYCODE_WORKER_LEASE_TTL=120
# RXYCODE_WORKER_EXECUTION is pinned to cloud-only by the prod overlay.
# Model name the worker writes into its deployed config (falls back to
# "deployed" when empty).
#RXYCODE_LLM_MODEL=

# --- optional integrations ----------------------------------------------------
# GitHub OAuth login — capabilities.github is true only when all three set.
#RXYCODE_GITHUB_CLIENT_ID=
#RXYCODE_GITHUB_CLIENT_SECRET=
#RXYCODE_GITHUB_REDIRECT_URI=
# Password-reset mail — without SMTP the forgot-password flow stays hidden in
# cloud mode (the API refuses to promise undeliverable links).
#   smtps://user:pass@smtp.example.com:465   implicit TLS
#   smtp://user:pass@smtp.example.com:587    STARTTLS
#RXYCODE_SMTP_URL=
# Sender header; defaults to the SMTP user when unset.
#RXYCODE_SMTP_FROM=RxyCode <no-reply@rxycode.xyz>
# Operator outbox fallback when no SMTP: forgot-password writes the reset
# link to the api container log (`docker logs <api> | grep "password reset"`).
# Only for single-admin self-hosted deploys — anyone with log access can
# take over accounts. =1 to enable; default off keeps the flow hidden.
#RXYCODE_RESET_OPERATOR_LOG=1
# Extra preview gate at the gateway (X-Preview-Token); empty = app auth only.
#RXYCODE_PREVIEW_TOKEN=
# Feedback library admins (v1.4.6): comma-separated user emails that can see
# /api/v1/admin/feedback/* — batches, per-batch detail, export, state triage.
# Empty = no admin surface at all (endpoints stay 404 for everyone).
#RXYCODE_FEEDBACK_ADMIN_EMAILS=
# Feedback batch capacity — a batch closes and rolls once it holds this many
# items (also rolls when a new build_commit deploys). Default 20.
#RXYCODE_FEEDBACK_BATCH_SIZE=20
# Artifact store overrides (defaults point at the in-stack MinIO).
#RXYCODE_S3_ENDPOINT=http://minio:9000
#RXYCODE_S3_BUCKET=rxycode-artifacts

# --- backup scripts (host env, not compose) -----------------------------------
# Root dir for infra/scripts/backup.sh output; restore.sh reads the same dirs.
#RXYCODE_BACKUP_DIR=D:\rxycode-backups

# Pinned by compose.prod.yaml — do NOT set here expecting an override:
#   RXYCODE_WEB_MODE=cloud, RXYCODE_WORKER_EXECUTION=cloud-only.
# Unused in prod: RXYCODE_PG_PORT (postgres publishes no port),
# RXYCODE_HTTPS_PORT (tailscaled terminates TLS), PIP_INDEX_URL (images carry
# all deps; nothing pip-installs at start).

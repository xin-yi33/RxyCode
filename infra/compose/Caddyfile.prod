# RxyCode web gateway — production behind Cloudflare Tunnel.
# TLS terminates at Cloudflare; cloudflared forwards to the host's loopback
# gateway port, so Caddy receives HTTP and must use Cloudflare's overwritten
# X-Forwarded-Proto value to distinguish the visitor's external scheme.
#
# Proxy semantics are identical to the dev Caddyfile: /api/* -> api:8000
# (SSE unbuffered), everything else -> the SPA baked at /srv/www.
#
# Client IPs: Cloudflare injects CF-Connecting-IP/X-Forwarded-For; the tunnel
# is the only public path to this listener and the host port is loopback-only.
{
	# Keep the admin API loopback-only inside the container (healthcheck probe).
	admin 127.0.0.1:2019
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	@public_http {
		host rxycode.xyz www.rxycode.xyz
		header X-Forwarded-Proto http
	}
	@public_https {
		host rxycode.xyz www.rxycode.xyz
		header X-Forwarded-Proto https
	}

	# route preserves this explicit order: redirect only trusted public HTTP;
	# unrelated hosts and loopback health/preview traffic continue unchanged.
	route {
		redir @public_http https://{host}{uri} 308
		header @public_https Strict-Transport-Security "max-age=86400"
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			-Server
		}

		# Preview-auth seam: sandbox preview pages ride on the app's own
		# owner-authenticated route (/api/v1/previews/*, rxycode_server
		# previews.proxy). When RXYCODE_PREVIEW_TOKEN is set in the gateway
		# environment the gateway additionally requires the caller to send
		# X-Preview-Token: <token>; when the env is empty the {$VAR} expansion
		# below collapses to `"" != ""`, i.e. pass-through to app auth.
		@preview_denied expression `path("/api/v1/previews/*") && "{$RXYCODE_PREVIEW_TOKEN}" != "" && {http.request.header.X-Preview-Token} != "{$RXYCODE_PREVIEW_TOKEN}"`
		respond @preview_denied 403

		# API, SSE, WebSocket and preview-auth paths retain the same upstream.
		# Cloudflare overwrites X-Forwarded-Proto with the visitor's actual
		# scheme; do not pin it to HTTPS or infer it from Caddy's HTTP hop.
		@api path /api/*
		handle @api {
			reverse_proxy api:8000 {
				flush_interval -1
				header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			}
		}

		# Baked SPA. No compression on the API handle above, so SSE flushes
		# remain unbuffered and WS/preview/API routing is unchanged.
		handle {
			encode zstd gzip
			root * /srv/www
			try_files {path} /index.html
			file_server
		}
	}
}

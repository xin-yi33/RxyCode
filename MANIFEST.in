include README.md
include CHANGELOG.md
include requirements.txt
include pyproject.toml
include install.ps1
include install.sh
include frontend/package.json
recursive-include frontend/dist *.js
recursive-include frontend/opentui-app/src *
include frontend/opentui-app/package.json
include frontend/opentui-app/tsconfig.json
include frontend/opentui-app/bun.lock
recursive-include frontend/protocol-client/src *
include frontend/protocol-client/package.json
include frontend/protocol-client/tsconfig.json
include core/agents/teams/*.yaml
recursive-include core/agents/teams *.yaml *.md
global-exclude *.py[cod]
global-exclude *.log
global-exclude *.key
global-exclude *.pem
global-exclude .env
global-exclude *.test.ts
global-exclude *.test.tsx
global-exclude .coveragerc
exclude AGENTS.md
exclude pytest.ini
exclude CONTRIBUTING.md
exclude Dockerfile
exclude docker-compose.yml
exclude .dockerignore
prune evals
prune tests
prune scripts
prune artifacts
prune data
prune frontend/node_modules
prune frontend/opentui-app/node_modules
prune frontend/opentui-app/e2e
prune frontend/protocol-client/node_modules
prune node_modules

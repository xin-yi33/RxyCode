# --- Secrets & user data ---
# Real config/API keys live in ~/.RxyCode or ~/.rxycode — never in this repo.
# (Git cannot ignore paths outside the repo; these rules catch accidental copies.)
data/
credentials.yaml
**/credentials.yaml
.RxyCode/
.rxycode/
# Local config copies (canonical config is only under the user home dirs above)
config.yaml
config.local.yaml
**/config.local.yaml
*.key
*.pem
*.p12
*.jks
*.secret
*.token
id_rsa
id_rsa.pub
.env
.env.*
.env.local
# Live-test / CI secret injection files (never commit real keys)
**/live_credentials.*
**/rxycode_gh_secret.txt
**/secrets.json
**/secret.txt


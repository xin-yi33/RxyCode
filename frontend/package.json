{
  "name": "rxycode-tui",
  "version": "1.2.2",
  "description": "RxyCode Terminal UI built with Ink (React for terminals)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && esbuild src/index.tsx --bundle --platform=node --format=esm --target=node18 --define:process.env.DEV=\"'false'\" --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/index.js",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run e2e",
    "e2e": "node e2e/run-pty.mjs"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "cli-spinners": "^3.0.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.1",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "react-devtools-core": "^4.28.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
